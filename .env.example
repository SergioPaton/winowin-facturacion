PORT=3001
NODE_ENV=development

# Configuración de Base de Datos
DATABASE_URL="file:./dev.db"

# JWT Secret
JWT_SECRET=tu-clave-secreta-para-jwt

# Configuración de VeriFactu
VERIFACTU_ENABLED=true
CERTIFICADO_PATH="ruta/al/certificado.p12"
CERTIFICADO_PASSWORD=contrasena-del-certificado

# Configuración de Emisor por defecto
EMISOR_NIF=12345678Z
EMISOR_NOMBRE="Nombre Empresa"
