{
  "name": "verifactu-facturacion",
  "version": "1.1.0",
  "description": "Sistema de facturación electrónica de escritorio Veri*Factu (RD 1007/2023) desarrollado con Electron, Express, Prisma y SQLite.",
  "main": "src/main.js",
  "scripts": {
    "dev": "node src/server.js",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "electron:build": "electron-builder",
    "start": "node src/server.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "lint": "eslint \"src/**/*.js\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "joi": "^18.1.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "mysql2": "^3.19.1",
    "node-forge": "^1.4.0",
    "nodemailer": "^8.0.3",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "xml-crypto": "^6.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "eslint": "^10.0.3",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "prisma": "^5.22.0"
  },
  "build": {
    "appId": "com.verifactu.facturacion",
    "productName": "VeriFactu Facturación",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json",
      "prisma-client/**/*"
    ],
    "asarUnpack": [
      "prisma-client/**/*.node"
    ],
    "extraResources": [
      {
        "from": "prisma/dev.db",
        "to": "dev.db"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}